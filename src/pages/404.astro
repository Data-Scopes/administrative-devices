---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base title="Page not found">
  <section class="section container prose">
    <p class="eyebrow">404</p>
    <h1>This page is not in the inventory</h1>
    <p class="lede">It may have moved, or the link points to a document that was never filed here.</p>
    <p><a href={url()}>Back to the home page</a></p>
  </section>
</Base>
