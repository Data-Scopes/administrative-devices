---
import mark from '../assets/icons/icon-D-index-tab.svg?url';
import { nav, site } from '../data/site';
import { url } from '../lib/url';

const here = Astro.url.pathname;
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={url()}>
      <img src={mark} alt="" width="36" height="36" />
      <span>{site.name}</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => {
            const href = url(item.href);
            const current = here.startsWith(href);
            return (
              <li>
                <a href={href} aria-current={current ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    min-height: 68px;
    padding-top: 10px;
    padding-bottom: 10px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
  }
  nav ul {
    list-style: none;
    display: flex;
    gap: clamp(14px, 3vw, 28px);
    margin: 0;
    padding: 0;
  }
  nav a {
    color: var(--ink-soft);
    text-decoration: none;
    font-weight: 500;
    padding: 4px 0;
    border-bottom: 2px solid transparent;
  }
  nav a:hover {
    color: var(--ink);
  }
  nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }
</style>
